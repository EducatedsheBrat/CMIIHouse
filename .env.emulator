# Used by `npm run dev:emu` — talks to the local Firebase emulators (`npm run emulators`).
# The "demo-" project id tells Firebase this is an offline demo project; no real credentials needed.
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-leaderquest.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-leaderquest
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-leaderquest.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo
NEXT_PUBLIC_ENABLE_EMAIL_LOGIN=true
